# Copy to .env.local and fill in. NEVER commit .env or .env.local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
VITE_APP_ENV=staging

# Required for db:push, db-verify, and the Playwright auth fixture (server-side scripts only).
# Never ship to the client.
SUPABASE_ACCESS_TOKEN=sbp_xxx
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Playwright auth fixture — pre-seeded test users in staging. The setup spec
# creates them on first run if missing. Use @example.com — Supabase's email
# validator rejects .test, .invalid, etc., even though they're IANA-reserved.
TEST_USER_ADMIN_EMAIL=e2e-admin@example.com
TEST_USER_VIEWER_EMAIL=e2e-viewer@example.com
